# Copy to .env (never commit it). Every value here is a dummy for local development only.

# --- Host ports (change if something on your machine already uses them) ---
NGINX_PORT=8080
POSTGRES_PORT=5432
LDAP_PORT=389

# --- PostgreSQL ---
POSTGRES_DB=questclass
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres-dev-password
# Login roles of the services; each can only use its own schema (core / game).
CORE_DB_PASSWORD=core-dev-password
GAME_DB_PASSWORD=game-dev-password

# --- Test LDAP (stands in for the faculty LABS domain) ---
LDAP_BASE_DN=dc=labs,dc=questclass,dc=test
LDAP_ADMIN_PASSWORD=ldap-admin-dev-password
# Password of every test account (infra/ldap/*.csv). Matches the frontend mocks.
LDAP_TEST_USER_PASSWORD=haslo

# --- Core/Game JWT ---
# Dummy local value only; Core and Game must use the same secret.
JWT_SECRET=local-development-secret-not-for-production-use
