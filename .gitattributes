# Normalize all text files to LF in the repository and working tree.
* text=auto eol=lf

# Images and other binary assets: never normalize or diff as text.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.bmp  binary
*.svg  text
*.woff  binary
*.woff2 binary
*.pdf  binary
*.docx binary
